NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase — defaults target the local emulator suite with the offline "demo-mesh" project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mesh
# For a real project, fill these from Firebase console → Project settings → Web app:
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_APP_ID=
