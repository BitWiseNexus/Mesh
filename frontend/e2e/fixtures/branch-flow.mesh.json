{
  "schema_version": 1,
  "flow_id": null,
  "name": "Branch demo",
  "description": "If / Else routes to one of two outputs.",
  "nodes": [
    {
      "id": "node_t",
      "type": "trigger_manual",
      "ref": "trigger",
      "data": {
        "input": "yes please"
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "node_i",
      "type": "logic_if",
      "ref": "check",
      "data": {
        "field": "{{input}}",
        "operator": "contains",
        "value": "yes"
      },
      "position": {
        "x": 400,
        "y": 0
      }
    },
    {
      "id": "node_yes",
      "type": "output_display",
      "ref": "approved",
      "data": {
        "label": "Approved"
      },
      "position": {
        "x": 800,
        "y": -120
      }
    },
    {
      "id": "node_no",
      "type": "output_display",
      "ref": "rejected",
      "data": {
        "label": "Rejected"
      },
      "position": {
        "x": 800,
        "y": 120
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "node_t",
      "sourceHandle": "out",
      "target": "node_i",
      "targetHandle": "in"
    },
    {
      "id": "e2",
      "source": "node_i",
      "sourceHandle": "true",
      "target": "node_yes",
      "targetHandle": "in"
    },
    {
      "id": "e3",
      "source": "node_i",
      "sourceHandle": "false",
      "target": "node_no",
      "targetHandle": "in"
    }
  ]
}
