{
  "schema_version": 1,
  "flow_id": null,
  "name": "Morning report",
  "description": "Runs at 9:00 on weekdays (Berlin time); the agent says when it was due.",
  "nodes": [
    {
      "id": "node_s",
      "type": "trigger_cron",
      "ref": "schedule",
      "data": { "label": "Every morning", "cron": "0 9 * * mon-fri", "timezone": "Europe/Berlin", "enabled": true },
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "node_a",
      "type": "agent_node",
      "ref": "reporter",
      "data": { "label": "Reporter", "model": "mock/echo", "prompt": "Report for {{schedule.output.scheduled_at}}" },
      "position": { "x": 400, "y": 0 }
    },
    {
      "id": "node_o",
      "type": "output_display",
      "ref": "report",
      "data": { "label": "Report" },
      "position": { "x": 800, "y": 0 }
    }
  ],
  "edges": [
    { "id": "e1", "source": "node_s", "sourceHandle": "out", "target": "node_a", "targetHandle": "in" },
    { "id": "e2", "source": "node_a", "sourceHandle": "out", "target": "node_o", "targetHandle": "in" }
  ]
}
