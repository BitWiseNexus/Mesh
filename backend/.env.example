APP_NAME=Mesh
ENVIRONMENT=development
# JSON list
CORS_ORIGINS=["http://localhost:3000"]

# Firebase — defaults target the local emulator suite with the offline "demo-mesh" project.
FIREBASE_PROJECT_ID=demo-mesh
USE_FIREBASE_EMULATORS=true
# For a real project: set USE_FIREBASE_EMULATORS=false and point to a service-account JSON.
# FIREBASE_CREDENTIALS_PATH=./service-account.json
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# LLM providers (optional; users can also save their own keys under API keys). Without any,
# use the `mock/echo` / `mock/tools` models to try flows locally.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# TAVILY_API_KEY=tvly-...   (Web Search; falls back to DuckDuckGo without one)
# RESEND_API_KEY=re_...      (Send Email; users can save their own)
# EMAIL_FROM="Mesh <mesh@your-verified-domain.com>"   (default sender; Resend's test sender
#                                                      only delivers to your own address)
# SLACK_BOT_TOKEN=xoxb-...   (Slack Message: a bot token with chat:write)
# TELEGRAM_BOT_TOKEN=123456789:AAH...   (Telegram Message: from @BotFather)

# Encrypts users' saved API keys. Required in production; comma-separate keys to rotate.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIALS_ENCRYPTION_KEY=

# Webhook triggers: the largest request body accepted, requests per minute per webhook, and how
# long callers wait for an answer.
# WEBHOOK_MAX_BODY_BYTES=1000000
# WEBHOOK_REQUESTS_PER_MINUTE=60
# How long a caller waits for the flow's HTTP Response node before getting 202 + the run id.
# WEBHOOK_RESPONSE_TIMEOUT_SECONDS=60

# Schedule triggers: the in-process scheduler (checks once a minute) and how late a run may start
# before it's skipped (e.g. the server was down at the time).
# SCHEDULER_ENABLED=true
# SCHEDULE_GRACE_SECONDS=300

# Let tools (API Caller, Web Scraper) reach private/local addresses. Default: allowed except in
# production.
# OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
