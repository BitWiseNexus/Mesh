APP_NAME=Mesh
ENVIRONMENT=development
# JSON list
CORS_ORIGINS=["http://localhost:3000"]

# Firebase — defaults target the local emulator suite with the offline "demo-mesh" project.
FIREBASE_PROJECT_ID=demo-mesh
USE_FIREBASE_EMULATORS=true
# For a real project: set USE_FIREBASE_EMULATORS=false and point to a service-account JSON.
# FIREBASE_CREDENTIALS_PATH=./service-account.json
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# LLM providers (optional; users can also save their own keys under API keys). Without any,
# use the `mock/echo` / `mock/tools` models to try flows locally.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# TAVILY_API_KEY=tvly-...   (Web Search; falls back to DuckDuckGo without one)

# Encrypts users' saved API keys. Required in production; comma-separate keys to rotate.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIALS_ENCRYPTION_KEY=

# Let tools (API Caller, Web Scraper) reach private/local addresses. Default: allowed except in
# production.
# OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
