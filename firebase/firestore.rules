rules_version = '2';

// The backend (firebase-admin) bypasses these rules entirely; it is the only writer. Clients may
// only *read* their own flows and runs (e.g. live run status via onSnapshot in Phase 3). Anything
// not matched below is denied by default — add a match here before reading a new collection from
// the browser, and cover it in tests/firestore.rules.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Read access to a document owned by the caller. For queries, Firestore only allows this if
    // the query itself filters on owner_uid == the caller's uid.
    function ownsExisting() {
      return signedIn() && resource.data.owner_uid == request.auth.uid;
    }

    match /flows/{flowId} {
      allow read: if ownsExisting();
      allow write: if false; // via the API only (validation, versioning, size limits)
    }

    match /runs/{runId} {
      allow read: if ownsExisting();
      allow write: if false; // written by the execution engine only
    }

    // Encrypted provider keys (Phase 4): never readable from a client, not even by their owner.
    match /credentials/{credentialId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
